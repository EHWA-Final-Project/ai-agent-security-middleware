{
  "name": "guardon-presentation-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "data": "uv run --project .. python scripts/export_data.py",
    "verify-data": "uv run --project .. python scripts/export_data.py --check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@phosphor-icons/react": "2.1.10"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
